{
  "version": 1,
  "author": "smart-locker",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 80,
      "left": 40,
      "attrs": { "env": "WOKWI" }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 0,
      "left": 40,
      "attrs": { "color": "red", "label": "Tu 1" }
    },
    {
      "type": "wokwi-led",
      "id": "led2",
      "top": 0,
      "left": 120,
      "attrs": { "color": "yellow", "label": "Tu 2" }
    },
    {
      "type": "wokwi-led",
      "id": "led3",
      "top": 0,
      "left": 200,
      "attrs": { "color": "green", "label": "Tu 3" }
    },

    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": 40,
      "left": 360,
      "attrs": { "pins": "i2c" }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer1",
      "top": 320,
      "left": 120,
      "attrs": { "label": "Beep" }
    },
    {
      "type": "wokwi-text",
      "id": "title1",
      "top": -30,
      "left": 60,
      "attrs": { "text": "Smart Locker x3 — MQTT Wokwi (No Servo)" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:2", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.1", "black", [] ],
    [ "esp:4", "led2:A", "green", [] ],
    [ "led2:C", "esp:GND.2", "black", [] ],
    [ "esp:15", "led3:A", "green", [] ],
    [ "led3:C", "esp:GND.3", "black", [] ],
    [ "esp:21", "lcd1:SDA", "green", [] ],
    [ "esp:22", "lcd1:SCL", "yellow", [] ],
    [ "lcd1:VCC", "esp:5V", "red", [] ],
    [ "lcd1:GND", "esp:GND.4", "black", [] ],
    [ "esp:23", "buzzer1:1", "green", [] ],
    [ "buzzer1:2", "esp:GND.5", "black", [] ]
  ]
}
